; 《妖怪夜市》v0.4.2
; The v0.2.4 browser game is reference material only; nothing is embedded here.

config_version=5

[application]

config/name="妖怪夜市"
config/description="中式夜市题材车道塔防 · 三天十五夜"
config/version="0.4.2"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.png"
boot_splash/show_image=true
boot_splash/image="res://assets/bg/loading-menu.png"
boot_splash/bg_color=Color(0.031, 0.055, 0.071, 1)
config/use_custom_user_dir=true
config/custom_user_dir_name="YokaiNightMarket"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/size/min_width=1280
window/size/min_height=720
window/size/resizable=true
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.031, 0.055, 0.071, 1)
2d/snap/snap_2d_transforms_to_pixel=false

[audio]

driver/enable_input=false
driver/mix_rate=44100

[editor]

import/use_multiple_threads=false

[input_devices]

pointing/emulate_touch_from_mouse=false

[gui]

theme/default_font_multichannel_signed_distance_field=false

[debug]

gdscript/warnings/treat_warnings_as_errors=false
file_logging/enable_file_logging=true
