extends SceneTree
var checks: Array=[]
var failures:=0
func check(name: String, value: bool) -> void:
	checks.append({"name":name,"ok":value})
	if not value:failures+=1;printerr("FAIL ",name)
func _initialize() -> void:run.call_deferred()
func touch(at: Vector2, pressed: bool) -> void:
	var event:=InputEventScreenTouch.new();event.index=0;event.position=at;event.pressed=pressed;root.push_input(event,true)
func tap(at: Vector2) -> void:
	touch(at,true);touch(at,false)
func settle() -> void:
	for i in 3:await process_frame
func run() -> void:
	root.size=Vector2i(1600,900)
	var game=load("res://scenes/main.tscn").instantiate();root.add_child(game);await settle()
	check("移动封面独立排版",game.mobile and game.screen_node.kind=="menu")
	check("关闭触屏鼠标自动模拟避免双触发",not Input.emulate_mouse_from_touch)
	check("系统返回键不会自动退出对局",not quit_on_go_back)
	game.show_levels();await settle()
	check("选关保留五周滚筒",game.screen_node._week_buttons.size()==5 and game.screen_node._week_scroll.size.y>580)
	game.screen_node.select_day(5);game.screen_node.select_night(4)
	check("五周五夜映射不变",game.screen_node.selected==26)
	game.show_prep(26);await settle()
	check("备战采用手机排版",game.screen_node.kind=="prep")
	game.open_almanac("boss",5);await settle()
	check("移动恶首图鉴可读",game.screen_node.kind=="almanac" and game.screen_node.tab=="boss")
	game.close_overlay();await settle()
	check("图鉴返回备战",game.screen=="prep")
	game.open_settings();await settle();check("移动设置不含桌面窗口档",game.screen_node.kind=="settings")
	game.close_overlay();await settle()
	game.start_battle(1,["lantern","shooter","wall"]);await settle()
	check("战斗使用移动HUD",game.hud.get_script().resource_path.ends_with("mobile_hud.gd"))
	check("左侧卡牌触控尺寸",game.hud._card_nodes[0].size.x>=120 and game.hud._card_nodes[0].size.y>=116)
	check("棋盘整体等比变换",game.board.get_parent().transform==game.MOBILE_WORLD and game.units.get_parent()==game.board.get_parent())
	var at: Vector2=game.hud._card_nodes[0].get_global_rect().get_center()
	tap(at);await settle()
	check("轻点卡牌只触发一次选择",game.hud.card_selected==0)
	var aim: Vector2=game._mobile_world_transform()*Geo.to_screen(game.sim.cell_pos(3,2),game.sim.rows)
	tap(aim);await settle()
	var plant=game.sim.main_plant_at(3,2)
	check("触屏种植与棋盘投影一致",plant!=null and plant.type=="lantern")
	tap(at);await settle();touch(aim,true);game.touch_router._process(0.46);touch(aim,false);await settle()
	check("长按只取消不补发左键",game.hud.card_selected==-1 and game.sim.plants.size()==1)
	game.hud.try_open_menu(plant,game.sim.cell_pos(3,2));await settle()
	check("进化改为可点选说明面板",game.hud._fan!=null and game.hud._fan.get_script().resource_path.ends_with("mobile_upgrade.gd"))
	check("阅读进化时暂停推进",game.hud.blocks_simulation())
	game.hud.close_fan();game.show_pause();await settle()
	check("手机暂停菜单正常",game.paused and game.screen_node!=null)
	game.close_pause();await settle();check("暂停可恢复",not game.paused)
	game._notification(Node.NOTIFICATION_APPLICATION_PAUSED);await settle()
	check("切到后台自动暂停",game.paused)
	game._notification(Node.NOTIFICATION_APPLICATION_RESUMED)
	var out:=FileAccess.open("res://qa/mobile-tests.json",FileAccess.WRITE);out.store_string(JSON.stringify({"total":checks.size(),"failures":failures,"checks":checks},"  "))
	game.show_menu();await settle()
	game.queue_free();await settle()
	print("MOBILE TOTAL ",checks.size()," FAILURES ",failures)
	quit(0 if failures==0 else 1)
